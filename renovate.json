{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separateMajorReleases",
    ":separateMultipleMajorReleases",
    ":prHourlyLimitNone"
  ],
  "timezone": "Pacific/Auckland",
  "schedule": ["before 6am on Monday"],
  "labels": ["dependencies", "renovate"],
  "assignees": ["edithatogo"],
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "rangeStrategy": "bump",
  "rebaseWhen": "behind-base-branch",
  "enabledManagers": [
    "github-actions",
    "pep621",
    "pip_requirements",
    "pixi"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on Monday"]
  },
  "packageRules": [
    {
      "description": "Keep GitHub Actions separate and pinned to immutable commits.",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "semanticCommitType": "ci",
      "pinDigests": true,
      "automerge": false,
      "labels": ["dependencies", "github-actions", "security"]
    },
    {
      "description": "Batch non-major Python and Pixi dependency updates for review.",
      "matchManagers": ["pep621", "pip_requirements", "pixi"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python-non-major",
      "semanticCommitType": "build",
      "automerge": false,
      "labels": ["dependencies", "python", "pixi"]
    },
    {
      "description": "Major dependency updates require isolated review.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "separateMajorMinor": true,
      "automerge": false,
      "labels": ["dependencies", "major-update", "requires-review"]
    }
  ],
  "ignorePaths": [
    "derived/**",
    "exports/**",
    "data/**"
  ]
}